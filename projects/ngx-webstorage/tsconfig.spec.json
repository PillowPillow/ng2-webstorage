{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "../../out-tsc/spec",
		"types": [
			"jasmine",
			"node"
		]
	},
	"files": [
		"src/test.ts"
	],
	"include": [
		"**/*.spec.ts",
		"**/*.d.ts"
	],
	"exclude": [
		"**/*.stub.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
