{
	"compileOnSave": false,
	"compilerOptions": {
    "strict": true,
    "outDir": "./dist/out-tsc",
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "es2020",
    "typeRoots": [
      "node_modules/@types"
    ],
    "paths": {
      "ngx-webstorage": [
        "./dist/ngx-webstorage/ngx-webstorage",
        "./dist/ngx-webstorage"
      ],
      "ngx-webstorage-cross-storage": [
        "./dist/ngx-webstorage-cross-storage/ngx-webstorage-cross-storage",
        "./dist/ngx-webstorage-cross-storage"
      ]
    },
    // MUST stay false. With ES2022 [[Define]] semantics the decorated class fields
    // become own instance properties initialised to undefined, which shadow the
    // prototype accessors installed by DecoratorBuilder (helpers/decoratorBuilder.ts).
    // Flipping this silently breaks every @LocalStorage/@SessionStorage binding.
    "useDefineForClassFields": false
  },
	"angularCompilerOptions": {
	  "enableI18nLegacyMessageIdFormat": false,
	  "strictInjectionParameters": true,
	  "strictInputAccessModifiers": true,
	  "strictTemplates": true
	}
}
