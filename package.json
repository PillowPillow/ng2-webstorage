  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "build:lib": "ng build ngx-webstorage",
    "build:lib:watch": "ng build ngx-webstorage --watch",
    "test:lib": "ng test ngx-webstorage --watch false --progress=false",
    "test:lib:watch": "ng test ngx-webstorage --watch true --progress=false",
    "test:lib:coverage": "ng test ngx-webstorage --watch false --progress=false --code-coverage",
    "test:lib:headless": "ng test ngx-webstorage --browsers chrome_headless --watch false --progress=false",
    "test:lib:headless:coverage": "ng test ngx-webstorage --browsers chrome_headless --code-coverage --watch false --progress=false"
  },
  "private": true,
